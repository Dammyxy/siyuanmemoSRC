# Siyuan workspace path
# The workspace contains `data` folder
VITE_SIYUAN_WORKSPACE_PATH=/path/to/siyuan/workspace

# Manually set the dist dir to work with Symbolic Links
VITE_DEV_DIST_DIR=

# Enable in-process SRS backend worker bootstrap in ApplicationContext (Phase 2 rollout)
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_SRS_BACKEND_WORKER=false

# Enable kernel writer-lease precheck before worker review writes (Phase 4 rollout, default off)
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_KERNEL_WRITER_LEASE_GUARD=false

# Optional override for writer lease identity and ttl when guard enabled
VITE_SIYUANMEMO_KERNEL_WRITER_LEASE_INSTANCE_ID=
VITE_SIYUANMEMO_KERNEL_WRITER_LEASE_TTL_MS=12000

# Enable ws-main transaction ingestion into backend worker inbox (Phase 5 rollout, default off)
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_KERNEL_TRANSACTION_INGEST=false
