# Siyuan workspace path
# The workspace contains `data` folder
VITE_SIYUAN_WORKSPACE_PATH=/path/to/siyuan/workspace

# Manually set the dist dir to work with Symbolic Links
VITE_DEV_DIST_DIR=

# Enable in-process SRS backend worker bootstrap in ApplicationContext (release default)
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_SRS_BACKEND_WORKER=true

# Enable kernel writer relay runtime for backend-owned mutation families (release default)
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_KERNEL_WRITER_LEASE_GUARD=true

# Enable backend auto-card decision relay (default on for backend+writer mode)
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_AUTOCARD_DECISION_RELAY=true

# Optional override for writer lease identity and ttl when guard enabled
VITE_SIYUANMEMO_KERNEL_WRITER_LEASE_INSTANCE_ID=
VITE_SIYUANMEMO_KERNEL_WRITER_LEASE_TTL_MS=12000

# Enable ws-main transaction ingestion into backend worker inbox (Phase 5 rollout, default off)
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_KERNEL_TRANSACTION_INGEST=false

# Keep private API disabled by default until runtime exposure is finished
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_PRIVATE_API=false

# Keep AI backend runtime disabled by default until Phase 7 runtime migration is complete
# true/1/on/yes to enable, otherwise disabled
VITE_SIYUANMEMO_ENABLE_AI_BACKEND_RUNTIME=false
