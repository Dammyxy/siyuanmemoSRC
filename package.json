{
  "name": "siyuan-plugin-siyuanmemo",
  "version": "0.1.8",
  "type": "module",
  "description": "Stage 2 Flashcard Enhancement - Adding a complete spaced repetition system to SiYuan flashcards",
  "author": "Dammyxy",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "vite build --watch",
    "prebuild": "node check-i18n.cjs",
    "build": "vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "diagnostics": "node --loader ts-node/esm --experimental-specifier-resolution=node src/diagnostics/cli.ts report",
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "release": "node ./release.js",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ag-grid-community": "^35.0.0",
    "ag-grid-vue3": "^35.0.0",
    "p-limit": "^7.2.0",
    "ts-fsrs": "^5.2.3",
    "vue": "^3.3.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@types/node": "^20.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-perfectionist": "^4.2.0",
    "fast-check": "^4.5.3",
    "fast-glob": "^3.2.12",
    "glob": "^11.0.1",
    "happy-dom": "^15.11.7",
    "jsdom": "^28.0.0",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.62.1",
    "siyuan": "1.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^1.0.0",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^2.1.8"
  }
}
